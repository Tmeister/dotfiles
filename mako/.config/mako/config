# Mako Notification Configuration
#
# This config overrides Omarchy's default mako setup while preserving:
# - Theme colors (auto-updates when you switch themes)
# - Special notification rules (Spotify, DND, clickable notifications)
#
# Managed by dotfiles - protected from omarchy updates
# See: ~/.dotfiles/OMARCHY.md

# =============================================================================
# OMARCHY BASE CONFIGURATION
# =============================================================================

# 1. Omarchy base rules (Spotify invisible, DND mode, clickable notifications)
include=~/.local/share/omarchy/default/mako/core.ini

# 2. Current theme colors (symlink updates automatically with theme changes)
include=~/.config/omarchy/current/theme/mako.ini

# =============================================================================
# CUSTOM DESIGN OVERRIDES (Toast-style)
# Applied LAST - these override everything above
# =============================================================================

# Subtle rounded corners
border-radius=6

# Subtle border (1px white at 25% opacity)
border-size=1
border-color=#ffffff40

# Comfortable padding (vertical, horizontal)
padding=14,18

# Compact width
width=400

# Position and spacing
anchor=top-right
outer-margin=16

# Clean, readable font
font=System Font 14px

# Icon styling
icons=1
max-icon-size=24
icon-location=left
icon-border-radius=4

# Text formatting
markup=1
format=<b>%s</b>\n%b


